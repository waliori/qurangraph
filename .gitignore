node_modules
dist

# Local secrets / environment — NEVER commit. .env.example IS tracked (template).
/.env
/.env.*
!/.env.example

# Built data artifacts — reconstructed from the tracked corpora in data/source/
# via `npm run data:transform && npm run data:roots` (and inside the Dockerfile).
# data/source/ itself IS tracked: it holds the necessary, non-reconstructable
# inputs the build needs.
/public/data/quran-hafs.json
/public/data/roots.json
/public/data/lemmas.json
/public/data/morphology.json
/public/data/lexicons/
/public/data/semantic-neighbours.json
/public/data/relations.json
/public/data/expressions.json
/public/data/sources.json

# Resolved commit SHAs written by `npm run data:download` (provenance input, not a source)
/data/source/source-refs.json
