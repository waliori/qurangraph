# ── آيات.network — environment ──
# Copy to `.env` next to docker-compose.yml. Every value below has a working default,
# so an empty .env is fine for a local run; these are the knobs for a real deployment.
# See docs/API.md for the full list.

# ── The HTTP API (the `qurangraph-api` service) ──

# Where the `ui…` deep links in every API response should point — i.e. your app's origin.
# Must end in "/". Change this if you serve the app anywhere other than ayat.network.
API_APP_BASE=https://ayat.network/

# The API's own public base, used for `self` links and the OpenAPI `servers` block.
API_PUBLIC_BASE=https://ayat.network/api/v1

# EMPTY = open access, no key required. That is the launch posture.
# To require keys later: mint them with `npm run api:key -- some-label`, paste the whole
# `label:key` lines here comma-separated, and restart. Callers then send the part AFTER
# the label as `X-API-Key`. Nothing else about the API changes.
#   API_KEYS=research-partner:ayat_xxx,student-project:ayat_yyy
API_KEYS=

# Requests per IP per hour. The second applies to requests carrying a valid key.
# 0 disables the limiter entirely.
API_RATE_LIMIT=600
API_RATE_LIMIT_KEYED=6000

# Log every request to stdout (docker logs qurangraph-api).
API_LOG=false
