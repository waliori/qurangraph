# ── QuranGraph assistant (free-tier proxy) ──
# Copy to `.env` (same directory as docker-compose.yml) and fill in the key, then
# `docker compose up -d --build`. Only the assistant's FREE shared tier uses these;
# the app itself and the bring-your-own-key path work without any of them.

# Required for the free tier. Get one (free) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Gemini model the free tier serves. Flash is fast, cheap, ~1M context, strong Arabic.
# GEMINI_MODEL=gemini-2.5-flash

# Free-tier budget per visitor IP per UTC day, in TOKENS (prompt+completion). In-memory;
# resets on container restart. The real ceiling is Gemini's own free-tier quota.
# TOKEN_BUDGET_PER_DAY=100000

# Gemini 2.5's hidden "thinking" wastes tokens and truncates short answers, so it's OFF by
# default ("none"). Set "low"/"medium"/"high" to re-enable it (slower, more tokens).
# REASONING_EFFORT=none

# Optional: set a secret to enable the owner-only usage endpoint
#   GET /api/stats?token=<this>   → { uniqueIpsToday, requestsToday, tokensToday, … }
# Leave unset to keep /api/stats disabled (404).
# STATS_TOKEN=
